  "name": "Clock",
  "content": "import { motion } from \"motion/react\"\nimport { useId } from \"react\"\n\nconst DEFAULT_COLORS = {\n  frame: \"#B2AED1\",\n  face: \"#000000\",\n  markCardinal: \"#D9D9D9\",\n  markQuarter: \"white\",\n  markMinor: \"#2B2B2B\",\n  centerNut: \"#D9D9D9\",\n  handPrimary: \"white\",\n  handSecondary: \"#A26BFF\",\n  handStroke: \"white\",\n  hourHand: \"#D9D9D9\",\n  glowStart: \"#180020\",\n  glowEnd: \"#E497FF\",\n} as const\n\ntype ClockColors = {\n  [K in keyof typeof DEFAULT_COLORS]: string\n}\n\ntype Props = {\n  className?: string\n  colors?: Partial<ClockColors>\n  animate?: boolean\n  rotationSpeed?: number\n}\n\nexport default function Clock({\n  className = \"w-100\",\n  colors,\n  animate = true,\n  rotationSpeed = 40,\n}: Props) {\n  const c = { ...DEFAULT_COLORS, ...colors }\n  const uid = useId()\n  const paint0Id = `${uid}-paint0`\n  const paint1Id = `${uid}-paint1`\n  const paint2Id = `${uid}-paint2`\n  const paint3Id = `${uid}-paint3`\n  const paint4Id = `${uid}-paint4`\n  const paint5Id = `${uid}-paint5`\n  const maskId = `${uid}-mask`\n\n  return (\n    <div>\n      <svg\n        className={className}\n        fill=\"none\"\n        preserveAspectRatio=\"xMidYMid meet\"\n        viewBox=\"0 0 372 372\"\n      >\n        <g id=\"clock\">\n          <g id=\"clock-frame\">\n            <circle cx=\"186.5\" cy=\"185.5\" r=\"170.5\" fill={c.frame} />\n            <ellipse cx=\"186.5\" cy=\"187\" rx=\"170.5\" ry=\"169\" fill={c.face} fillOpacity=\"0.84\" />\n            <ellipse cx=\"186\" cy=\"187.5\" rx=\"153\" ry=\"154.5\" fill={`url(#${paint0Id})`} />\n            <circle cx=\"186\" cy=\"186\" r=\"153\" fill={c.face} />\n            <circle cx=\"186\" cy=\"186\" r=\"143.5\" stroke={`url(#${paint1Id})`} strokeOpacity=\"0.39\" />\n            <path opacity=\"0.46\" d=\"M357 188.5C357 232.924 339.037 275.528 307.062 306.94C275.087 338.353 231.719 356 186.5 356C141.281 356 97.9133 338.353 65.9383 306.94C33.9634 275.528 16 232.924 16 188.5