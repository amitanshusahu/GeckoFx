{
  "name": "geckofx",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "generate": "bun run generate:types && bun run generate:docs && bun run generate:registry && bun run generate:component-map && bun run generate:skillReferences",
    "generate:types": "tsx --tsconfig tsconfig.scripts.json scripts/src/types.autogen.ts",
    "generate:docs": "tsx --tsconfig tsconfig.scripts.json scripts/src/docs.autogen.ts",
    "generate:registry": "tsx --tsconfig tsconfig.scripts.json scripts/src/registry.autogen.ts",
    "generate:component-map": "tsx --tsconfig tsconfig.scripts.json scripts/src/componentMap.autogen.ts",
    "generate:skillReferences": "tsx --tsconfig tsconfig.scripts.json scripts/src/skillReferences.autogen.ts"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@tailwindcss/vite": "^4.3.1",
    "@tanstack/react-router": "^1.170.16",
    "clsx": "^2.1.1",
    "motion": "^12.40.0",
    "prism-react-renderer": "^2.4.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.1"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@eslint/js": "^10.0.1",
    "@rolldown/plugin-babel": "^0.2.3",
    "@tanstack/router-plugin": "^1.168.18",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^26.0.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@tanstack/react-router-devtools": "^1.167.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "tsx": "^4.22.4",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12"
  }
}